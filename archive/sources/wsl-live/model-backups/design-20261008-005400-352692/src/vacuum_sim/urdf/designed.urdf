  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0 0 0.085" rpy="0 0 0" />
  </joint>
  <link name="lidar_link">
    <inertial>
      <mass value="0.05" />
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00002" />
    </inertial>
    <collision>
      <geometry>
        <cylinder length="0.025" radius="0.03" />
      </geometry>
    </collision>
    <visual name="rplidar_mount_standoff">
      <origin xyz="0 0 -0.03" />
      <geometry>
        <cylinder length="0.032" radius="0.01" />
      </geometry>
      <material name="lidar_link_edited_2">
        <color rgba="0.62 0.68 0.75 1" />
      </material>
    </visual>
    <visual name="rplidar_c1_base">
      <origin xyz="0 0 -0.009" />
      <geometry>
        <box size="0.054 0.054 0.012" />
      </geometry>
      <material name="lidar_link_edited_2">
        <color rgba="0.08 0.1 0.14 1" />
      </material>
    </visual>
    <visual name="rplidar_c1_scanner">
      <origin xyz="0 0 0.005" />
      <geometry>
        <cylinder length="0.025" radius="0.027" />
      </geometry>
      <material name="lidar_link_edited_2">
        <color rgba="0.08 0.1 0.14 1" />
      </material>
    </visual>
    <visual name="rplidar_c1_accent">
      <origin xyz="0 0 0.015" />
      <geometry>
        <cylinder length="0.004" radius="0.025" />
      </geometry>
      <material name="lidar_link_edited_2">
        <color rgba="0.95 0.58 0.18 1" />
      </material>
    </visual>
  </link>
  <gazebo reference="lidar_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10.0</update_rate>
      <always_on>true</always_on>
      <lidar>
        <scan>
          <horizontal>
            <samples>500</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.015</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.1325 0 0.025" rpy="0 0 0" />
  </joint>
  <link name="camera_link">
    <inertial>
      <mass value="0.03" />
      <inertia ixx="0.000004" ixy="0" ixz="0" iyy="0.000004" iyz="0" izz="0.000004" />
    </inertial>
    <visual>
