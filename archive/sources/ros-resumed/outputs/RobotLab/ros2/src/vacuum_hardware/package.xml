<?xml version="1.0"?>
<package format="3">
  <name>vacuum_hardware</name><version>0.1.0</version>
  <description>Orange Pi serial bridge for a Mega 2560 and two TB6600 drivers.</description>
  <maintainer email="[REDACTED_EMAIL]">Robot Lab owner</maintainer><license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend><exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend><exec_depend>python3-serial</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
