#!/usr/bin/env bash
# Commands for the Argus bench workspace on the Orange Pi.
set -e
cd -- "$(dirname -- "$(readlink -f -- "$0")")"
case "${1:-help}" in
  status|demo)
    exec /usr/bin/python3 -m argus_avoidance.bench "$1" ;;
  line-preview)
    shift
    exec /usr/bin/python3 -m argus_avoidance.line_preview "$@" ;;
  follow)
    shift
    exec /usr/bin/python3 -m argus_avoidance.follow "$@" ;;
  roam)
    shift
    exec /usr/bin/python3 -m argus_avoidance.roam "$@" ;;
  obstacle-calibrate)
    shift
    exec /usr/bin/python3 -m argus_avoidance.obstacles --profile .state/floor.json --calibrate "$@" ;;
  obstacle-status)
    exec /usr/bin/python3 -c 'import json,urllib.request; print(json.dumps(json.load(urllib.request.urlopen("http://127.0.0.1:8767/status",timeout=2)),indent=2))' ;;
  check)
    exec /usr/bin/python3 -m unittest discover -s tests ;;
  scan)
    source /opt/ros/humble/setup.bash
    exec /usr/bin/python3 -m argus_avoidance.bench scan ;;
  preview)
    source /opt/ros/humble/setup.bash
    if [ ! -r .ros/install/local_setup.bash ]; then
      echo "Build this workspace as described in START-HERE.md first." >&2
      exit 1
    fi
    source .ros/install/local_setup.bash
    exec ros2 launch argus_avoidance guarded_preview.launch.py enable_output:=false ;;
  help|-h|--help)
    cat <<'HELP'
Argus on the Orange Pi
  ./argus demo     Watch the decisions in a simulated wall approach
  ./argus status   Show the Pi, Linux, ROS and serial devices
  ./argus check    Run the software checks
  ./argus scan     Listen for three real lidar scans (10 second limit)
  ./argus line-preview  Print tape steering decisions from the live camera
  ./argus follow   Preview the tape follower; --drive selects the prepared ESP32 session API
  ./argus roam --lidar PORT  Preview C1 stop-turn-continue; explicit --drive requires commissioning
  ./argus obstacle-status  Show calibrated camera-preview status
  ./argus obstacle-calibrate  Calibrate a clear floor patch while STOPPED, motors OFF
  ./argus preview  Run the ROS controller with motor output disabled
Read START-HERE.md for the first session. Ctrl+C stops a running command.
HELP
    ;;
  *) echo "Unknown command. Run ./argus for the list." >&2; exit 2 ;;
esac
